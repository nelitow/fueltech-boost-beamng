// Sunburst2 EJ255/EJ257 Engine Tunes — Phase 1
//
// Adds two realistic Subaru-spec long-block + turbo pairs to the Sunburst2's existing
// "2.5L F4 Engine" tuning tree (sunburst2_engine_2_5.jbeam, base game content — not edited).
// These are ADDITIONAL options in the same slots as the game's own Stock/Stage 1/Stage 2
// parts, authored with the same delta pattern ($* multiply, $+ add, torqueModMult reshapes
// the base NA torque curve, components.exhaustPowerAdd is a shared value the turbo's
// maxExhaustPower formula reads).
//
// Target numbers (widely-cited SAE net crank figures, used as tuning targets):
//   EJ255 (WRX): ~230 hp @ 5600rpm, ~235 lb-ft (319 Nm) @ 3600rpm, TD04, ~14.2 psi
//   EJ257 (STI): ~305 hp @ 6000rpm, ~290 lb-ft (393 Nm) @ 4000rpm, TD05, ~14.5-14.7 psi
//
// The turbo's wastegate target is normally read from a $wastegateTarget variable supplied
// by whichever ECU part is installed (see sunburst2_engine_2_5.jbeam). To keep these two
// turbos self-contained regardless of ECU choice, wastegateStart/wastegateLimit are set
// directly here instead of depending on $wastegateTarget.
{

"sunburst2_engine_2_5_internals_ej255": {
    "information":{
        "authors":"Nelito",
        "name":"EJ255 Long Block (WRX)",
        "value":5200,
    },
    "slotType" : "sunburst2_engine_2_5_internals",
    "slots2": [
        ["name","allowTypes","denyTypes","default","description"],
        ["sunburst2_ej_bottomend", ["sunburst2_ej_bottomend"], [], "sunburst2_ej_bottomend_stock", "Bottom End"],
        ["sunburst2_ej_heads", ["sunburst2_ej_heads"], [], "sunburst2_ej_heads_single_avcs", "Cylinder Heads"],
    ],
    "mainEngine":{
        // Real EJ255 peak torque lands around 3600rpm, notably earlier than this engine's
        // stock NA curve (peaks 4500rpm) — this reshapes the base curve toward that, with a
        // mild taper past 6000 reflecting the WRX's shorter-duration cam profile vs the STI.
        // Solved against the verified getTorqueData model (torque = (base*mult + exhaustMod)*turboCoef
        // - friction - dynamicFriction*rpm*pi/30; power reported in mechanical HP). Assumes the TD04's
        // default stock turbo exhaust (torqueModExhaust -4.9Nm@4000) and 5.0 psi coef midpoint.
        // Targets: 319 Nm @ ~3600, 230 hp @ ~5600.
        "torqueModMult":[
        ["rpm", "torque"],
        [0,       1.00],
        [500,     1.00],
        [1000,    1.00],
        [1500,    1.02],
        [2000,    1.05],
        [2500,    1.07],
        [3000,    1.082],
        [3500,    1.0715],
        [4000,    1.0542],
        [4500,    1.0410],
        [5000,    1.0398],
        [5500,    1.0574],
        [6000,    1.0064],
        [6500,    0.9740],
        [7000,    0.95],
        [7500,    0.92],
        [8000,    0.89],
        [8500,    0.86],
        [9000,    0.83],
        [9500,    0.80],
        [10000,   0.78]
    ]
        // Real WRX soft-limits around 6700rpm.
        "$+maxRPM":-300,
        "$+maxPhysicalRPM":-300,
        "$*friction":1.10,
        "$*dynamicFriction":1.10,
        "$*inertia":1.08,
        "$*engineBrakeTorque":1.0,
        // Semi-closed-deck block — stock-boost-safe headroom, not a high-boost block.
        "$*maxTorqueRating": 1.5,
        "$*maxOverTorqueDamage": 1.3,
    },
    "components": {
        "exhaustPowerAdd": {
          "exhaustPowerAdd":0
        },
    },
},

"sunburst2_engine_2_5_internals_ej257": {
    "information":{
        "authors":"Nelito",
        "name":"EJ257 Long Block (STI)",
        "value":6800,
    },
    "slotType" : "sunburst2_engine_2_5_internals",
    "slots2": [
        ["name","allowTypes","denyTypes","default","description"],
        ["sunburst2_ej_bottomend", ["sunburst2_ej_bottomend"], [], "sunburst2_ej_bottomend_stock", "Bottom End"],
        ["sunburst2_ej_heads", ["sunburst2_ej_heads"], [], "sunburst2_ej_heads_dual_avcs", "Cylinder Heads"],
    ],
    "mainEngine":{
        // Flatter and sustained further into the rev range than the EJ255 — dual AVCS
        // (intake + exhaust, vs WRX's intake-only) broadens the powerband; peak torque
        // still lands early (~4000rpm) but the STI keeps pulling hard well past 6000rpm.
        // Solved against the verified getTorqueData model (torque = (base*mult + exhaustMod)*turboCoef
        // - friction - dynamicFriction*rpm*pi/30; power reported in mechanical HP). Assumes the TD05's
        // race turbo exhaust (torqueModExhaust -1.4Nm@4000) and 7.0 psi coef midpoint.
        // Targets: 393 Nm @ ~4000, 305 hp @ ~6000.
        "torqueModMult":[
        ["rpm", "torque"],
        [0,       1.00],
        [500,     1.00],
        [1000,    1.00],
        [1500,    1.02],
        [2000,    1.06],
        [2500,    1.09],
        [3000,    1.104],
        [3500,    1.1668],
        [4000,    1.1680],
        [4500,    1.1577],
        [5000,    1.1617],
        [5500,    1.1741],
        [6000,    1.1839],
        [6500,    1.1416],
        [7000,    1.0955],
        [7500,    1.05],
        [8000,    1.00],
        [8500,    0.95],
        [9000,    0.90],
        [9500,    0.85],
        [10000,   0.80]
    ]
        "$*friction":1.05,
        "$*dynamicFriction":1.08,
        "$*inertia":1.12,
        "$*engineBrakeTorque":1.1,
        // Closed-deck block — genuinely more boost-tolerant stock than the EJ255.
        "cylinderWallTemperatureDamageThreshold":145,
        "engineBlockTemperatureDamageThreshold":130,
        "$*maxTorqueRating": 1.9,
        "$*maxOverTorqueDamage": 1.5,
    },
    "components": {
        "exhaustPowerAdd": {
          "exhaustPowerAdd":40
        },
    },
},

"sunburst2_engine_2_5_intake_td04": {
    "information":{
        "authors":"Nelito",
        "name":"TD04 Turbocharger (WRX)",
        "value":6500,
    },
    "slotType" : "sunburst2_engine_2_5_intake",
    "slots2": [
        ["name","allowTypes","denyTypes","default","description"],
        ["sunburst2_exhaust_turbo_stock", ["sunburst2_exhaust_turbo_stock"], [], "sunburst2_exhaust_turbo_stock", "Exhaust"],
        ["sunburst2_ej_intercooler", ["sunburst2_ej_intercooler"], [], "sunburst2_ej_intercooler_fmic", "Intercooler"],
    ],
    "components": {
        "exhaustPowerAdd": {
        },
    },
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_01>turbo_bov",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_03>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_02>turbo_spin",
        // Small, quick-spooling — real TD04 character, only a little bigger than this
        // engine's own stock turbo (0.65).
        "turboSizeCoef": 0.72,
        "bovSoundVolumeCoef": 0.7,
        "hissVolumePerPSI": 0.035,
        "whineVolumePer10kRPM": 0.028,
        "whinePitchPer10kRPM": 0.075,
        // Live-verified against this engine's own coef model (K_PSI~0.05998, this
        // curve's own efficiency table) to land near the EJ255 target (~319Nm@3600rpm,
        // ~230hp@5600rpm) — NOT a literal transcription of the real turbo's PSI rating.
        // This engine's base NA curve already sits close to WRX-like output once even
        // modest boost is applied, so real-world PSI figures overshoot badly here.
        "wastegateStart": 4.5,
        "wastegateLimit": 5.5,
        "maxExhaustPower": "$=$components.exhaustPowerAdd.exhaustPowerAdd == nil and 600 or $components.exhaustPowerAdd.exhaustPowerAdd+600",
        "backPressureCoef": 0.0000022,
        "pressureRatePSI": 50,
        "frictionCoef": 20,
        "inertia":0.32,
        "damageThresholdTemperature": 680,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,       -2.5],
            [10000,   -1.0],
            [30000,     6],
            [60000,    12],
            [90000,    19],
            [150000,   24],
            [200000,   28],
            [250000,   32],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor — good low-end (real TD04 trait), flow
            //ceiling reached earlier than a bigger turbo (tapers from ~6000rpm).
            [0,     0.00,    0.00],
            [650,   0.22,    0.16],
            [1400,  0.55,    0.48],
            [2000,  0.83,    0.70],
            [2500,  0.90,    0.82],
            [3000,  0.94,    0.96],
            [4000,  0.97,    1.00],
            [5000,  0.97,    1.00],
            [6000,  0.94,    0.98],
            [7000,  0.88,    0.94],
            [8000,  0.80,    0.92],
            [9000,  0.68,    0.90],
            [10000, 0.60,    0.85],
            [11000, 0.50,    0.85],
        ],
    },
    "mainEngine":{
        "turbocharger":"turbocharger",
        "$*instantAfterFireCoef": 1.2,
        "$*sustainedAfterFireCoef": 1.2,
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler","mainEngine_piping"]
    },
    "soundConfig": {
        "$+intakeMuffling":-0.1,
        "$+mainGain":0.4,
        "$+maxLoadMix": 0.15,
        "$+offLoadGain":-0.02,
    },
    "soundConfigExhaust": {
        "$+maxLoadMix": 0.15,
        "$+mainGain": -0.8,
        "$+offLoadGain": -0.02,
    },
},

