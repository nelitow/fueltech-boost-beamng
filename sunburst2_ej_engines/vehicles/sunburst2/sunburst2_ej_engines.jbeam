// Bottom End / forged internals + compression ratio — Phase 2, item 4. Nested under BOTH
// EJ255 and EJ257 long blocks (see their "slots2" above). Deliberately does NOT touch
// torqueModMult — that curve is already dyno-verified against the real EJ255/EJ257 targets
// on each block, and a second part redeclaring the same "torqueModMult" key would silently
// REPLACE it rather than stack (jbeam merge is last-part-wins on non-$ fields). Every field
// below is a $*/$+ delta instead, which merges safely on top of whatever the parent block set.
// "Stock" is a true no-op so existing saves default here with zero behavior change.
"sunburst2_ej_bottomend_stock": {
    "information":{
        "authors":"Nelito",
        "name":"Stock Bottom End",
        "value":0,
    },
    "slotType" : "sunburst2_ej_bottomend",
},
"sunburst2_ej_bottomend_forged_lowcomp": {
    "information":{
        "authors":"Nelito",
        "name":"Forged Closed-Deck Bottom End (8.0:1 Low Compression)",
        "value":2400,
    },
    "slotType" : "sunburst2_ej_bottomend",
    "mainEngine":{
        // Low static compression trades a little low-boost/NA-like response for a much
        // higher safe ceiling once real boost comes in — the classic "built for big turbo"
        // internals choice. Forged rotating assembly adds a little rotating mass/drag.
        "$*maxTorqueRating": 1.15,
        "$*maxOverTorqueDamage": 1.25,
        "$+cylinderWallTemperatureDamageThreshold": 15,
        "$+engineBlockTemperatureDamageThreshold": 12,
        "$*friction": 1.03,
        "$*engineBrakeTorque": 0.95,
    },
},
"sunburst2_ej_bottomend_forged_highcomp": {
    "information":{
        "authors":"Nelito",
        "name":"Forged Closed-Deck Bottom End (9.5:1 High Compression)",
        "value":2400,
    },
    "slotType" : "sunburst2_ej_bottomend",
    "mainEngine":{
        // Higher static compression sharpens response and stock-boost efficiency, still
        // forged/closed-deck for reliability, but less over-boost headroom than the
        // low-compression build since it's closer to its knock limit at high boost.
        "$*maxTorqueRating": 1.08,
        "$*maxOverTorqueDamage": 1.15,
        "$+cylinderWallTemperatureDamageThreshold": 8,
        "$+engineBlockTemperatureDamageThreshold": 6,
        "$*friction": 1.02,
        "$*engineBrakeTorque": 1.05,
    },
},

// AVCS Cylinder Heads — Phase 2, item 5. Nested under both long blocks. The actual breathing
// character difference between single (WRX) and dual (STI) AVCS is already baked into each
// block's own torqueModMult curve shape (that's the block's core identity) — this sub-slot
// exists so the choice is explicit and swappable (e.g. a dual-AVCS head swap onto an EJ255),
// using only safe $ deltas for the same reason as the bottom-end parts above.
"sunburst2_ej_heads_single_avcs": {
    "information":{
        "authors":"Nelito",
        "name":"Single AVCS Heads (Intake)",
        "value":0,
    },
    "slotType" : "sunburst2_ej_heads",
},
"sunburst2_ej_heads_dual_avcs": {
    "information":{
        "authors":"Nelito",
        "name":"Dual AVCS Heads (Intake + Exhaust)",
        "value":1800,
    },
    "slotType" : "sunburst2_ej_heads",
    "mainEngine":{
        // Exhaust-side cam control lets the engine breathe cleanly a little further into
        // the rev range and marginally reduces pumping losses.
        "$+maxRPM": 100,
        "$+maxPhysicalRPM": 100,
        "$*dynamicFriction": 0.98,
    },
},

// Front-Mount / Top-Mount Intercooler — Phase 2, item 6. Nested under both TD04 and TD05
// turbos. No dedicated intercooler mesh exists for this vehicle (it has no intercooler slot
// at all in the base game), so — per go-ahead to reuse in-game assets rather than fabricate
// geometry — these are functional-only parts with no unique 3D model, the same convention
// the base game already uses for its own ECU tune parts. Effects target "mainEngine"'s
// thermal-damage-threshold fields (confirmed present on the base engine) rather than
// turbocharger-specific fields, to avoid guessing at an internal key name and risking a
// silent no-op.
"sunburst2_ej_intercooler_fmic": {
    "information":{
        "authors":"Nelito",
        "name":"Front-Mount Intercooler (FMIC)",
        "value":900,
    },
    "slotType" : "sunburst2_ej_intercooler",
    "mainEngine":{
        // Larger frontal core in clean airflow — best sustained charge cooling on long
        // high-load pulls. Real WRX/STI both run FMIC stock, so this is also the default.
        "$+cylinderWallTemperatureDamageThreshold": 8,
        "$+engineBlockTemperatureDamageThreshold": 6,
    },
},
"sunburst2_ej_intercooler_tmic": {
    "information":{
        "authors":"Nelito",
        "name":"Top-Mount Intercooler (TMIC)",
        "value":750,
    },
    "slotType" : "sunburst2_ej_intercooler",
    "mainEngine":{
        // Shorter charge piping than an FMIC (quicker spool feel, approximated here as
        // marginally less parasitic drag), but sits over the hot engine bay so it has less
        // sustained-heat margin than a proper front-mount core.
        "$+cylinderWallTemperatureDamageThreshold": 3,
        "$+engineBlockTemperatureDamageThreshold": 2,
        "$*dynamicFriction": 0.995,
    },
},

// Flex-Fuel Alcohol Tune (E85/Methanol) — Phase 2, item 7. New option in the existing
// sunburst2_engine_2_5_ecu slot, alongside the base game's own Stock/Sport/Stage1/Stage2/
// Adjustable Race ECU parts. Adds boost via $+wastegateStart/$+wastegateLimit deltas rather
// than touching torqueModMult — these operate on whatever wastegate value is already merged
// in, so they add correctly on top of the TD04/TD05's own literal (non-$wastegateTarget)
// PSI values. This is also how "stage tunes" already work on these turbos: any ECU part
// using $+wastegate* deltas (including the base game's own Stage1/Stage2) stacks safely
// regardless of which turbo is installed. Represents the real-world benefit of alcohol
// fuel's higher octane and charge-cooling effect allowing more aggressive boost/timing
// without immediately risking knock — not a literal fuel-chemistry simulation.
"sunburst2_engine_2_5_ecu_alcohol": {
    "information":{
        "authors":"Nelito",
        "name":"Flex-Fuel Alcohol Tune (E85/Methanol)",
        "value":1600,
    },
    "slotType" : "sunburst2_engine_2_5_ecu",
    // The turbo device is registered under a top-level "turbocharger" key (see
    // "mainEngine":{"turbocharger":"turbocharger"} in the TD04/TD05 parts) — deltas have to
    // target that same key to merge onto the turbo's own data, not "mainEngine".
    "turbocharger":{
        "$+wastegateStart": 1.5,
        "$+wastegateLimit": 1.5,
    },
    "mainEngine":{
        "$*maxOverTorqueDamage": 1.1,
    },
},

