},

// STI 6-Speed Manual Transaxle — Phase 2, item 1. Real close-ratio STI 6MT gearset
// (1st-6th + reverse), same slot as the game's own 5-speed/CVT/DCT/6-speed-sequential
// options (sunburst2_transaxle), reusing the existing flywheel/transfer-case/front-diff
// child slots exactly like sunburst2_transaxle_5M does. Fixed real ratios rather than
// the 5M's per-gear-swappable-slot pattern, since this represents one specific real
// gearset rather than a build-your-own-ratios option.
"sunburst2_transaxle_6M_sti": {
    "information":{
        "authors":"Nelito",
        "name":"STI 6-Speed Manual Transaxle",
        "value":4600,
    },
    "slotType" : "sunburst2_transaxle",
    "slots2": [
        ["name",                     "allowTypes",                 "denyTypes", "default",                     "description"],
        ["sunburst2_flywheel",       ["sunburst2_flywheel"],       [],          "sunburst2_flywheel",          "Flywheel",           {"coreSlot":true}],
        ["sunburst2_transfer_case",  ["sunburst2_transfer_case"],  [],          "sunburst2_transfer_case_AWD", "Transfer Case"],
        ["sunburst2_differential_F", ["sunburst2_differential_F"], [],          "sunburst2_differential_F",    "Front Differential"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["frictionClutch", "clutch", "mainEngine", 1],
        ["manualGearbox", "gearbox", "clutch", 1],
    ],
    "vehicleController": {
        "calculateOptimalLoadShiftPoints": true,
        "shiftDownRPMOffsetCoef":1.20,
        "lowShiftDownRPM":[0,0,0,1400,1500,1500,1450,1450,1450],
        "lowShiftUpRPM":[0,0,3500,3200,2900,2700,2600,2600],
        "clutchLaunchStartRPM": 2500,
        "clutchLaunchTargetRPM": 3200,
    },
    "gearbox": {
        "uiName":"Gearbox",
        // Real STI 6MT ratios (widely-cited): 3.636 / 2.375 / 1.761 / 1.346 / 1.062 / 0.795,
        // reverse 3.545 (same reverse as the 5-speed).
        "gearRatios":[-3.545, 0, 3.636, 2.375, 1.761, 1.346, 1.062, 0.795],
        "friction": 1.22,
        "dynamicFriction": 0.00115,
        "torqueLossCoef": 0.0158,
        "gearboxNode:":["tra1"],

        "gearWhineCoefsInput":  [0.60, 0.00, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24, 0.24],
        "gearWhineInputEvent": "event:>Vehicle>Transmission>helical_01>twine_in",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>helical_01>twine_out",
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["sunburst2_transmission", ["sunburst2_engine","sunburst2_transaxle"]],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"selfCollision":false},
         {"collision":true},
         {"group":"sunburst2_transaxle"},
         {"nodeWeight":24},
         ["tra1", 0.000, -0.750,  0.335],
         {"group":""},
    ],
    "beams":[
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":15001000,"beamDamp":500},
        {"beamDeform":175000,"beamStrength":"FLT_MAX"},
        ["tra1", "e2r"],
        ["tra1", "e4r"],
        ["tra1", "e2l"],
        ["tra1", "e4l"],
        ["tra1", "e1r"],
        ["tra1", "e3r"],
        ["tra1", "e1l"],
        ["tra1", "e3l"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},

