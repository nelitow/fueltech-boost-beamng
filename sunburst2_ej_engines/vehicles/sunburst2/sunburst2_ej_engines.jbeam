// Mishimoto-style Performance Radiator — Phase 2, item 3. Real Mishimoto aluminum radiators
// for WRX/STI are known for a much larger core than OEM while keeping the stock thermostat
// temp (unlike a race radiator's lower thermostat setting) since they're a daily-driving
// upgrade, not a track-only part. Reuses the existing race-radiator visual mesh (no new mesh
// assets available), but with the base game's own radiator/race/ultra tiers as the guide for
// distinct cooling numbers: effectiveness set above race (9000) but well below the fully
// track-only ultra tier (18000, which also drops the thermostat to 85C), matching a
// higher-flow street/spirited-driving core rather than a race-only setup.
"sunburst2_radiator_mishimoto": {
    "information":{
        "authors":"Nelito",
        "name":"Mishimoto Performance Radiator",
        "value":620,
    },
    "slotType" : "sunburst2_radiator",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["sunburst2_radiator_race", ["sunburst2_radiator"]],
         {"deformGroup":"radhose_damage", "deformMaterialBase":"generic_perf_parts", "deformMaterialDamaged":"invis"},
         ["sunburst2_radiator_race_pipes", ["sunburst2_engine","sunburst2_radiator"]],
         {"deformGroup":"", "deformationTriggerRatio":""},
    ],
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        ["radiatorFanSpin", "sunburst2_radiator_race_fan_R", "rad1","f15r","rad2", {"x":0, "y":0, "z":18}, {"x":0, "y":-1, "z":0}, {"x":0, "y":0, "z":0}, -360, 360, 0, 1],
        ["radiatorFanSpin", "sunburst2_radiator_race_fan_L", "rad1","f15l","rad2", {"x":0, "y":0, "z":162}, {"x":0, "y":-1, "z":0}, {"x":0, "y":0, "z":0}, -360, 360, 0, 1],
    ],
    "mainEngine":{
        "radiatorArea":0.34,
        "radiatorEffectiveness":12500,
        "coolantVolume":9,
        "radiatorFanType":"electric",
        "radiatorFanTemperature":98,
        "radiatorFanMaxAirSpeed":3,
        "thermostatTemperature":90,
